import torch, numpy as np
import matplotlib.pyplot as plt
from PIL import Image
from models.CCMSRNet import UNet
from utils import process_image_lab

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
net    = UNet(3, 3, img_size=256).to(device)
ckpt   = torch.load(CKPT_BEST, map_location=device)
net.load_state_dict(ckpt['net'])
net.eval()

test_raw = f"{DATA_INPUT}/test/raw/"
test_ref = f"{DATA_INPUT}/test/reference/"
files    = sorted(os.listdir(test_raw))[:5]

fig, axes = plt.subplots(len(files), 3, figsize=(12, 4 * len(files)))

for i, fname in enumerate(files):
    img_pil = Image.open(os.path.join(test_raw, fname)).convert('RGB')
    gt_pil  = Image.open(os.path.join(test_ref, fname)).convert('RGB')

    img_np = process_image_lab(img_pil)          # preprocessing (not timed)
    inp    = torch.from_numpy(img_np).permute(2,0,1).float() / 255.0
    inp    = inp.unsqueeze(0).to(device)

    with torch.no_grad():
        cc, pred = net(inp)

    pred_np = np.clip(pred.squeeze().permute(1,2,0).cpu().numpy(), 0, 1)

    axes[i][0].imshow(np.array(img_pil));  axes[i][0].set_title('Input (raw)')
    axes[i][1].imshow(pred_np);            axes[i][1].set_title('CCMSRNet output')
    axes[i][2].imshow(np.array(gt_pil));   axes[i][2].set_title('Ground truth')
    for ax in axes[i]: ax.axis('off')

plt.suptitle('CCMSRNet (Optimized) – Qualitative Results', fontsize=14)
plt.tight_layout()
out_img = '/kaggle/working/visual_comparison.png'
plt.savefig(out_img, dpi=120)
plt.show()
print(f'Saved: {out_img}')





import numpy as np, matplotlib.pyplot as plt

train_loss = np.load(os.path.join(EXP_LOG, 'tr_mse_loss.npy'))
val_loss   = np.load(os.path.join(EXP_LOG, 'val_mse_loss.npy'))

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

axes[0].plot(train_loss, color='steelblue',  label='Train MSE')
axes[0].set_title('Training Loss'); axes[0].set_xlabel('Epoch')
axes[0].legend(); axes[0].grid(True)

axes[1].plot(val_loss,   color='darkorange', label='Val MSE')
axes[1].set_title('Validation Loss'); axes[1].set_xlabel('Epoch')
axes[1].legend(); axes[1].grid(True)

plt.tight_layout()
out_lc = '/kaggle/working/loss_curves.png'
plt.savefig(out_lc, dpi=120)
plt.show()

print(f'Best val loss : {val_loss.min():.5f}  (epoch {val_loss.argmin()+1})')
print(f'Final train   : {train_loss[-1]:.5f}')
print(f'Saved: {out_lc}')





